                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="av_trig" delay="0.0" conditionEdge="rising">
                                        <ByValueCondition>
                                            <SimulationTimeCondition value="0.0" rule="greaterThan" />
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                        <Event name="av_go" priority="overwrite" maximumExecutionCount="1">
                            <Action name="av_go">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsShape="linear" value="1.0" dynamicsDimension="time" />
                                            <SpeedActionTarget>
                                                <AbsoluteTargetSpeed value="2.994" />
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="av_trig" delay="0.0" conditionEdge="rising">
                                        <ByValueCondition>
                                            <SimulationTimeCondition value="0.0" rule="greaterThan" />
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                        <Event name="av_partial_intrusion" priority="overwrite" maximumExecutionCount="1">
                            <Action name="av_partial_intrusion">
                                <PrivateAction>
                                    <LateralAction>
                                        <LaneOffsetAction continuous="true">
                                            <LaneOffsetActionDynamics maxLateralAcc="0.8" dynamicsShape="sinusoidal" />
                                            <LaneOffsetTarget>
                                                <AbsoluteTargetLaneOffset value="1.4000000000000001" />
                                            </LaneOffsetTarget>
                                        </LaneOffsetAction>
                                    </LateralAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="c2x_ads_av_near" delay="0.0" conditionEdge="none">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="hero" />
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <RelativeDistanceCondition value="8.0" freespace="true" entityRef="av" rule="lessThan" relativeDistanceType="cartesianDistance" />
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                    <Condition name="c2x_ads_av_clear" delay="0.0" conditionEdge="none">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="hero" />
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <RelativeDistanceCondition value="0.5" freespace="true" entityRef="av" rule="greaterThan" relativeDistanceType="cartesianDistance" />
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                    <Condition name="c2x_ads_av_ego_moving" delay="0.0" conditionEdge="none">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="hero" />
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <SpeedCondition value="1.0" rule="greaterThan" />
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                    <Condition name="c2x_ads_av_npc_moving" delay="0.0" conditionEdge="none">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="av" />
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <SpeedCondition value="2.0" rule="greaterThan" />
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
