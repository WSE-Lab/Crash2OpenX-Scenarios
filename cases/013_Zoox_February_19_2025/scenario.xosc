<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="OpenScenario.xsd">
    <FileHeader description="scene_seed_block_scenario" author="ads_testing" revMajor="1" revMinor="0" date="2026-09-19T14:00:58.081667" />
    <ParameterDeclarations>
        <ParameterDeclaration name="C2XADSActor" parameterType="string" value="hero" />
        <ParameterDeclaration name="C2XADSTriggers" parameterType="string" value="{&quot;v2&quot;: {&quot;reference_actor&quot;: &quot;hero&quot;, &quot;event&quot;: &quot;v2_cut&quot;, &quot;distance_semantics&quot;: &quot;cartesian_freespace&quot;, &quot;min_clearance_m&quot;: 0.5, &quot;min_ego_speed_mps&quot;: 1.0, &quot;min_npc_speed_mps&quot;: 2.0, &quot;distance_m&quot;: 3.0}}" />
        <ParameterDeclaration name="C2XSourceManeuver" parameterType="string" value="straight" />
    </ParameterDeclarations>
    <CatalogLocations>
        <VehicleCatalog>
            <Directory path="openscenarios/catalogs" />
        </VehicleCatalog>
        <ControllerCatalog>
            <Directory path="openscenarios/catalogs" />
        </ControllerCatalog>
        <PedestrianCatalog>
            <Directory path="openscenarios/catalogs" />
        </PedestrianCatalog>
        <MiscObjectCatalog>
            <Directory path="openscenarios/catalogs" />
        </MiscObjectCatalog>
        <EnvironmentCatalog>
            <Directory path="openscenarios/catalogs" />
        </EnvironmentCatalog>
    </CatalogLocations>
    <RoadNetwork>
        <LogicFile filepath="map.xodr" />
    </RoadNetwork>
    <Entities>
        <ScenarioObject name="hero">
            <Vehicle name="vehicle.tesla.model3" vehicleCategory="car">
                <BoundingBox>
                    <Center x="1.5" y="0.0" z="0.9" />
                    <Dimensions width="2.1" length="4.5" height="1.8" />
                </BoundingBox>
                <Performance maxSpeed="69.4" maxDeceleration="10.0" maxAcceleration="200.0" />
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="3.1" positionZ="0.3" />
                    <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.8" positionX="0.0" positionZ="0.3" />
                </Axles>
                <Properties>
                    <Property name="type" value="ego_vehicle" />
                </Properties>
            </Vehicle>
        </ScenarioObject>
        <ScenarioObject name="v2">
            <Vehicle name="vehicle.tesla.model3" vehicleCategory="car">
                <BoundingBox>
                    <Center x="1.5" y="0.0" z="0.9" />
                    <Dimensions width="2.1" length="4.5" height="1.8" />
                </BoundingBox>
                <Performance maxSpeed="69.4" maxDeceleration="10.0" maxAcceleration="200.0" />
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="3.1" positionZ="0.3" />
                    <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.8" positionX="0.0" positionZ="0.3" />
                </Axles>
                <Properties>
                    <Property name="type" value="simulation" />
                </Properties>
            </Vehicle>
        </ScenarioObject>
        <ScenarioObject name="cyclist">
            <Vehicle name="vehicle.diamondback.century" vehicleCategory="bicycle">
                <BoundingBox>
                    <Center x="0.0" y="0.0" z="0.9" />
                    <Dimensions width="0.6" length="1.8" height="1.8" />
                </BoundingBox>
                <Performance maxSpeed="15.0" maxDeceleration="8.0" maxAcceleration="4.0" />
                <Axles>
                    <FrontAxle maxSteering="0.7" wheelDiameter="0.7" trackWidth="0.1" positionX="0.6" positionZ="0.35" />
                    <RearAxle maxSteering="0.0" wheelDiameter="0.7" trackWidth="0.1" positionX="-0.6" positionZ="0.35" />
                </Axles>
                <Properties>
                    <Property name="type" value="simulation" />
                    <Property name="semantic_type" value="cyclist" />
                </Properties>
            </Vehicle>
        </ScenarioObject>
    </Entities>
    <Storyboard>
        <Init>
            <Actions>
                <GlobalAction>
                    <EnvironmentAction>
                        <Environment name="Environment1">
                            <TimeOfDay animation="false" dateTime="2024-06-15T18:00:00" />
                            <Weather cloudState="free">
                                <Sun azimuth="0.0" intensity="0.85" elevation="1.31" />
                                <Fog visualRange="100000.0" />
                                <Precipitation precipitationType="dry" intensity="0.0" />
                            </Weather>
                            <RoadCondition frictionScaleFactor="1.0" />
                        </Environment>
                    </EnvironmentAction>
                </GlobalAction>
                <Private entityRef="hero">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-1" s="30.0" offset="0.0" />
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <ControllerAction>
                            <OverrideControllerValueAction>
                                <Throttle active="false" value="0.0" />
                                <Brake active="false" value="0.0" />
                                <Clutch active="false" value="0.0" />
                                <ParkingBrake active="false" value="0.0" />
                                <SteeringWheel active="false" value="0.0" />
                                <Gear active="false" number="0.0" />
                            </OverrideControllerValueAction>
                            <AssignControllerAction>
                                <Controller name="HeroAgent">
                                    <Properties>
                                        <Property name="module" value="external_control" />
                                    </Properties>
                                </Controller>
                            </AssignControllerAction>
                        </ControllerAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="linear" value="0.0" dynamicsDimension="time" />
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="4.99" />
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
                <Private entityRef="v2">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <RelativeLanePosition entityRef="hero" ds="24.0" offset="0.0" dLane="-1" />
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <ControllerAction>
                            <OverrideControllerValueAction>
                                <Throttle active="false" value="0.0" />
                                <Brake active="false" value="0.0" />
                                <Clutch active="false" value="0.0" />
                                <ParkingBrake active="false" value="0.0" />
                                <SteeringWheel active="false" value="0.0" />
                                <Gear active="false" number="0.0" />
                            </OverrideControllerValueAction>
                            <AssignControllerAction>
                                <Controller name="v2_scripted_control">
                                    <Properties>
                                        <Property name="module" value="npc_vehicle_control" />
                                    </Properties>
                                </Controller>
                            </AssignControllerAction>
                        </ControllerAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="linear" value="0.0" dynamicsDimension="time" />
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="2.994" />
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
                <Private entityRef="cyclist">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <RelativeLanePosition entityRef="hero" ds="34.0" offset="0.0" dLane="-1" />
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <ControllerAction>
                            <OverrideControllerValueAction>
                                <Throttle active="false" value="0.0" />
                                <Brake active="false" value="0.0" />
                                <Clutch active="false" value="0.0" />
                                <ParkingBrake active="false" value="0.0" />
                                <SteeringWheel active="false" value="0.0" />
                                <Gear active="false" number="0.0" />
                            </OverrideControllerValueAction>
                            <AssignControllerAction>
                                <Controller name="cyclist_scripted_control">
                                    <Properties>
                                        <Property name="module" value="npc_vehicle_control" />
                                    </Properties>
                                </Controller>
                            </AssignControllerAction>
                        </ControllerAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>
        <Story name="scene_story">
            <Act name="scene_act">
                <ManeuverGroup name="hero_grp" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="hero" />
                    </Actors>
                    <Maneuver name="hero_goal_man">
                        <Event name="hero_acquire_goal" priority="overwrite" maximumExecutionCount="1">
                            <Action name="hero_acquire_goal">
                                <PrivateAction>
                                    <RoutingAction>
                                        <AcquirePositionAction>
                                            <Position>
                                                <LanePosition roadId="1" laneId="-1" s="230.0" offset="0.0" />
                                            </Position>
                                        </AcquirePositionAction>
                                    </RoutingAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="hero_trig" delay="0.0" conditionEdge="rising">
                                        <ByValueCondition>
                                            <SimulationTimeCondition value="0.0" rule="greaterThan" />
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <ManeuverGroup name="v2_grp" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="v2" />
                    </Actors>
                    <Maneuver name="v2_man">
                        <Event name="v2_go" priority="overwrite" maximumExecutionCount="1">
                            <Action name="v2_go">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsShape="linear" value="1.0" dynamicsDimension="time" />
                                            <SpeedActionTarget>
                                                <AbsoluteTargetSpeed value="2.994" />
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="v2_trig" delay="0.0" conditionEdge="rising">
                                        <ByValueCondition>
                                            <SimulationTimeCondition value="0.0" rule="greaterThan" />
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                        <Event name="v2_cut" priority="overwrite" maximumExecutionCount="1">
                            <Action name="v2_cut">
                                <PrivateAction>
                                    <LateralAction>
                                        <LaneChangeAction>
                                            <LaneChangeActionDynamics dynamicsShape="linear" value="7.485" dynamicsDimension="distance" />
                                            <LaneChangeTarget>
                                                <RelativeTargetLane value="1" entityRef="v2" />
                                            </LaneChangeTarget>
                                        </LaneChangeAction>
                                    </LateralAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="c2x_ads_v2_near" delay="0.0" conditionEdge="none">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="hero" />
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <RelativeDistanceCondition value="3.0" freespace="true" entityRef="v2" rule="lessThan" relativeDistanceType="cartesianDistance" />
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                    <Condition name="c2x_ads_v2_clear" delay="0.0" conditionEdge="none">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="hero" />
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <RelativeDistanceCondition value="0.5" freespace="true" entityRef="v2" rule="greaterThan" relativeDistanceType="cartesianDistance" />
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                    <Condition name="c2x_ads_v2_ego_moving" delay="0.0" conditionEdge="none">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="hero" />
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <SpeedCondition value="1.0" rule="greaterThan" />
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                    <Condition name="c2x_ads_v2_npc_moving" delay="0.0" conditionEdge="none">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="v2" />
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <SpeedCondition value="2.0" rule="greaterThan" />
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <ManeuverGroup name="cyclist_grp" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="cyclist" />
                    </Actors>
                    <Maneuver name="cyclist_man">
                        <Event name="cyclist_cruise" priority="overwrite" maximumExecutionCount="1">
                            <Action name="cyclist_cruise">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsShape="linear" value="1.0" dynamicsDimension="time" />
                                            <SpeedActionTarget>
                                                <AbsoluteTargetSpeed value="3.0" />
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="cyclist_trig" delay="0.0" conditionEdge="rising">
                                        <ByValueCondition>
                                            <SimulationTimeCondition value="0.0" rule="greaterThan" />
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="scene_act_trig" delay="0.0" conditionEdge="rising">
                            <ByValueCondition>
                                <SimulationTimeCondition value="0.0" rule="greaterThan" />
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger>
                    <ConditionGroup>
                        <Condition name="act_stop" delay="0.0" conditionEdge="rising">
                            <ByEntityCondition>
                                <TriggeringEntities triggeringEntitiesRule="any">
                                    <EntityRef entityRef="hero" />
                                </TriggeringEntities>
                                <EntityCondition>
                                    <TraveledDistanceCondition value="200.0" />
                                </EntityCondition>
                            </ByEntityCondition>
                        </Condition>
                    </ConditionGroup>
                <ConditionGroup><Condition name="experiment_duration" delay="0" conditionEdge="rising"><ByValueCondition><SimulationTimeCondition value="25" rule="greaterThan" /></ByValueCondition></Condition></ConditionGroup></StopTrigger>
            </Act>
        </Story>
        <StopTrigger>
            <ConditionGroup>
                <Condition name="act_stop" delay="0.0" conditionEdge="rising">
                    <ByEntityCondition>
                        <TriggeringEntities triggeringEntitiesRule="any">
                            <EntityRef entityRef="hero" />
                        </TriggeringEntities>
                        <EntityCondition>
                            <TraveledDistanceCondition value="220.0" />
                        </EntityCondition>
                    </ByEntityCondition>
                </Condition>
            </ConditionGroup>
        <ConditionGroup><Condition name="criteria_RunningStopTest" delay="0" conditionEdge="rising"><ByValueCondition><ParameterCondition parameterRef="" value="" rule="lessThan" /></ByValueCondition></Condition></ConditionGroup><ConditionGroup><Condition name="criteria_RunningRedLightTest" delay="0" conditionEdge="rising"><ByValueCondition><ParameterCondition parameterRef="" value="" rule="lessThan" /></ByValueCondition></Condition></ConditionGroup><ConditionGroup><Condition name="criteria_WrongLaneTest" delay="0" conditionEdge="rising"><ByValueCondition><ParameterCondition parameterRef="" value="" rule="lessThan" /></ByValueCondition></Condition></ConditionGroup><ConditionGroup><Condition name="criteria_OnSidewalkTest" delay="0" conditionEdge="rising"><ByValueCondition><ParameterCondition parameterRef="" value="" rule="lessThan" /></ByValueCondition></Condition></ConditionGroup><ConditionGroup><Condition name="criteria_KeepLaneTest" delay="0" conditionEdge="rising"><ByValueCondition><ParameterCondition parameterRef="" value="" rule="lessThan" /></ByValueCondition></Condition></ConditionGroup><ConditionGroup><Condition name="criteria_CollisionTest" delay="0" conditionEdge="rising"><ByValueCondition><ParameterCondition parameterRef="" value="" rule="lessThan" /></ByValueCondition></Condition></ConditionGroup><ConditionGroup><Condition name="criteria_DrivenDistanceTest" delay="0" conditionEdge="rising"><ByValueCondition><ParameterCondition parameterRef="distance_success" value="100" rule="lessThan" /></ByValueCondition></Condition></ConditionGroup><ConditionGroup><Condition name="experiment_duration" delay="0" conditionEdge="rising"><ByValueCondition><SimulationTimeCondition value="25" rule="greaterThan" /></ByValueCondition></Condition></ConditionGroup></StopTrigger>
    </Storyboard>
</OpenSCENARIO>