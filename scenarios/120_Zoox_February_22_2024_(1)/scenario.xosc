                        <Event name="bus_depart" priority="overwrite" maximumExecutionCount="1">
                            <Action name="bus_depart">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsShape="linear" value="2.6666666666666665" dynamicsDimension="time" />
                                            <SpeedActionTarget>
                                                <AbsoluteTargetSpeed value="8.0" />
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="c2x_ads_bus_near" delay="0.0" conditionEdge="none">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="hero" />
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <RelativeDistanceCondition value="39.521" freespace="true" entityRef="bus" rule="lessThan" relativeDistanceType="cartesianDistance" />
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                    <Condition name="c2x_ads_bus_clear" delay="0.0" conditionEdge="none">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="hero" />
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <RelativeDistanceCondition value="0.5" freespace="true" entityRef="bus" rule="greaterThan" relativeDistanceType="cartesianDistance" />
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                    <Condition name="c2x_ads_bus_ego_moving" delay="0.0" conditionEdge="none">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="hero" />
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <SpeedCondition value="1.0" rule="greaterThan" />
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                        <Event name="bus_route_stop" priority="overwrite" maximumExecutionCount="1">
                            <Action name="bus_route_stop">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsShape="linear" value="1.0" dynamicsDimension="time" />
                                            <SpeedActionTarget>
                                                <AbsoluteTargetSpeed value="0.0" />
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="bus_cross_finished" delay="0.0" conditionEdge="rising">
                                        <ByValueCondition>
                                            <StoryboardElementStateCondition storyboardElementType="event" storyboardElementRef="bus_cross" state="endTransition" />
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="scene_act_trig" delay="0.0" conditionEdge="rising">
                            <ByValueCondition>
                                <SimulationTimeCondition value="0.0" rule="greaterThan" />
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger>
                    <ConditionGroup>
                        <Condition name="act_stop" delay="0.0" conditionEdge="rising">
                            <ByEntityCondition>
                                <TriggeringEntities triggeringEntitiesRule="any">
                                    <EntityRef entityRef="hero" />
                                </TriggeringEntities>
                                <EntityCondition>
                                    <TraveledDistanceCondition value="200.0" />
                                </EntityCondition>
                            </ByEntityCondition>
                        </Condition>
                    </ConditionGroup>
                <ConditionGroup><Condition name="experiment_duration" delay="0" conditionEdge="rising"><ByValueCondition><SimulationTimeCondition value="25" rule="greaterThan" /></ByValueCondition></Condition></ConditionGroup></StopTrigger>
            </Act>
        </Story>
        <StopTrigger>
            <ConditionGroup>
                <Condition name="act_stop" delay="0.0" conditionEdge="rising">
                    <ByEntityCondition>
                        <TriggeringEntities triggeringEntitiesRule="any">
                            <EntityRef entityRef="hero" />
                        </TriggeringEntities>
                        <EntityCondition>
                            <TraveledDistanceCondition value="220.0" />
                        </EntityCondition>
                    </ByEntityCondition>
                </Condition>
            </ConditionGroup>
        <ConditionGroup><Condition name="criteria_RunningStopTest" delay="0" conditionEdge="rising"><ByValueCondition><ParameterCondition parameterRef="" value="" rule="lessThan" /></ByValueCondition></Condition></ConditionGroup><ConditionGroup><Condition name="criteria_RunningRedLightTest" delay="0" conditionEdge="rising"><ByValueCondition><ParameterCondition parameterRef="" value="" rule="lessThan" /></ByValueCondition></Condition></ConditionGroup><ConditionGroup><Condition name="criteria_WrongLaneTest" delay="0" conditionEdge="rising"><ByValueCondition><ParameterCondition parameterRef="" value="" rule="lessThan" /></ByValueCondition></Condition></ConditionGroup><ConditionGroup><Condition name="criteria_OnSidewalkTest" delay="0" conditionEdge="rising"><ByValueCondition><ParameterCondition parameterRef="" value="" rule="lessThan" /></ByValueCondition></Condition></ConditionGroup><ConditionGroup><Condition name="criteria_KeepLaneTest" delay="0" conditionEdge="rising"><ByValueCondition><ParameterCondition parameterRef="" value="" rule="lessThan" /></ByValueCondition></Condition></ConditionGroup><ConditionGroup><Condition name="criteria_CollisionTest" delay="0" conditionEdge="rising"><ByValueCondition><ParameterCondition parameterRef="" value="" rule="lessThan" /></ByValueCondition></Condition></ConditionGroup><ConditionGroup><Condition name="criteria_DrivenDistanceTest" delay="0" conditionEdge="rising"><ByValueCondition><ParameterCondition parameterRef="distance_success" value="100" rule="lessThan" /></ByValueCondition></Condition></ConditionGroup><ConditionGroup><Condition name="experiment_duration" delay="0" conditionEdge="rising"><ByValueCondition><SimulationTimeCondition value="25" rule="greaterThan" /></ByValueCondition></Condition></ConditionGroup></StopTrigger>
    </Storyboard>
</OpenSCENARIO>